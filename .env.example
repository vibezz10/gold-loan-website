# Copy this file to .env and fill in real values before running the server.

# Port the server listens on
PORT=3000

# Password used to protect the /admin dashboard and admin API routes.
# Change this to something only you and your uncle know.
ADMIN_PASSWORD=change-this-password

# Default values shown on the public site until changed from /admin
GOLD_RATE_PER_GRAM=6800
BRANCH_PHONE=+91 90000 00000
BRANCH_ADDRESS=Shop No. 12, Main Bazaar Road, Your City
